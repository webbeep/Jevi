# --- Cloudflare (used by the deploy script only, never uploaded as a secret) ---
CLOUDFLARE_ACCOUNT_ID=

# --- AI (required for the full experience) ---
# Jev by TypeSafe AI: picks components, answer sentences and action buttons
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
# DeepSeek: writes summaries, tables, steps, pros/cons, follow-ups
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# --- Optional free-tier search keys (keyless engines always run too) ---
# Brave Search, free tier: https://brave.com/search/api/
BRAVE_API_KEY=
# Tavily, 1,000 free credits/month: https://tavily.com
TAVILY_API_KEY=
# Serper (Google results), 2,500 free queries: https://serper.dev
SERPER_API_KEY=
# Jina search, free starter tokens: https://jina.ai/?sui=apikey
JINA_API_KEY=

# Marginalia works keyless via the shared "public" key; a free personal key avoids its rate limits
MARGINALIA_API_KEY=

# Comma-separated SearXNG instances that allow format=json (optional override)
SEARXNG_URLS=
