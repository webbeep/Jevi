# --- Cloudflare (used by the deploy script only, never uploaded as a secret) ---
CLOUDFLARE_ACCOUNT_ID=

# --- AI (required for the full experience) ---
# Jev by TypeSafe AI: picks components, answer sentences and action buttons
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
# DeepSeek: writes summaries, tables, steps, pros/cons, follow-ups
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# --- Optional fallback language models, tried in this order when DeepSeek fails ---
# Each is used only when its key is set; *_MODEL / *_BASE_URL override the defaults shown.
# Google Gemini, free tier via AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq, free tier (1,000 requests/day): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter, free ":free" models (50 requests/day): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Mistral, free experiment tier: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Paid providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Any other OpenAI-compatible endpoint
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Cloudflare Workers AI (the AI binding in wrangler.toml) is the keyless last resort; set to "off" to disable.
WORKERS_AI=
# Optional: comma-separated provider ids to change the order or leave some out,
# e.g. deepseek,groq,gemini,openrouter,mistral,openai,anthropic,custom,workers-ai
LLM_ORDER=

# --- Optional free-tier search keys (keyless engines always run too) ---
# Brave Search, free tier: https://brave.com/search/api/
BRAVE_API_KEY=
# Tavily, 1,000 free credits/month: https://tavily.com
TAVILY_API_KEY=
# Serper (Google results), 2,500 free queries: https://serper.dev
SERPER_API_KEY=
# LangSearch web search. Empty skips the engine: https://docs.langsearch.com/api/web-search-api
LANGSEARCH_API_KEY=
# Firecrawl /v1/search. Empty skips the engine: https://docs.firecrawl.dev/api-reference/v1-endpoint/search
FIRECRAWL_API_KEY=
# Exa search type. Default fast. instant is a later replay switch, not the default.
EXA_SEARCH_TYPE=
# DuckDuckGo lite backup. Off unless exactly 1. Lead/QA check it from a Worker before turning it on.
ZO_DDG_BACKUP=
# Jina search, free starter tokens: https://jina.ai/?sui=apikey
JINA_API_KEY=
# Exa search with page text, free $10 credit every month (~1,400 searches): https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# --- Pictures ---
# Wikipedia, Wikimedia Commons and Openverse (commercial-use licenses only) are keyless and always on.
# Pexels stock photos, free key, commercial use allowed: https://www.pexels.com/api/new/
PEXELS_API_KEY=
# Unsplash, free key (50 req/h demo, 5,000/h after approval), commercial use allowed: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# "source" (default): also show publishers' own preview images as credited thumbnails that link back, like search engines do.
# "open": only Creative Commons / public domain / stock pictures — the safest choice for a commercial product.
IMAGE_POLICY=source
# Perplexity Search API — no free tier, pay-as-you-go $5 / 1k requests: https://www.perplexity.ai/account/api
PERPLEXITY_API_KEY=

# Marginalia works keyless via the shared "public" key; a free personal key avoids its rate limits
MARGINALIA_API_KEY=

# Comma-separated SearXNG instances that allow format=json (optional override)
SEARXNG_URLS=
