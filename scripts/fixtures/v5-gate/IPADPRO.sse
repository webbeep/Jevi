data: {"query":"How much is the iPad Pro?","pattern":"spotlight","alternatives":[{"id":"spotlight","label":"Spotlight","description":"One big headline value (a current reading, price, score, count or status) with small supporting tiles, a short series over time, and a few details"},{"id":"answer","label":"Direct answer","description":"A short factual question with a direct answer, followed by a few supporting facts"},{"id":"compare","label":"Side by side","description":"Two or more options compared attribute by attribute, ending with a verdict"}],"skeleton":{"title":"How much is the iPad Pro?","subtitle":"Spotlight","body":[{"type":"stack","direction":"row","gap":"md","children":[{"type":"slot","hint":"headline value","shape":"hero"},{"type":"slot","hint":"context","shape":"block"}]},{"type":"scroller","children":[{"type":"slot","hint":"series over time: tiles for a few upcoming values, or a line chart for a longer trend","shape":"tile"},{"type":"slot","hint":"series","shape":"tile"},{"type":"slot","hint":"series","shape":"tile"},{"type":"slot","hint":"series","shape":"tile"},{"type":"slot","hint":"series","shape":"tile"}]},{"type":"grid","cols":2,"gap":"md","children":[{"type":"slot","hint":"detail","shape":"tile"},{"type":"slot","hint":"detail","shape":"tile"},{"type":"slot","hint":"detail","shape":"tile"},{"type":"slot","hint":"detail","shape":"tile"}]}]},"confidence":0.87,"depth":"brief","readPages":true,"think":false,"ms":154}

