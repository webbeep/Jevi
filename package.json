{
  "name": "zo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/icons.mjs && node scripts/env-sync.mjs dev && mkdir -p dist && concurrently -k -n api,web \"wrangler pages dev dist --port 8788\" \"vite\"",
    "build": "node scripts/icons.mjs && tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "npm run build && node scripts/env-sync.mjs dev && wrangler pages dev dist --port 8788",
    "secrets": "node scripts/env-sync.mjs secrets",
    "deploy": "npm run build && node scripts/env-sync.mjs deploy",
    "test:e2e": "node scripts/e2e.mjs",
    "test:unit": "node --experimental-strip-types --test scripts/relevance.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-is": "^19.3.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.40.0"
  }
